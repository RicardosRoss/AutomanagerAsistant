{
  "name": "telegram-self-control-bot",
  "version": "1.0.0",
  "type": "module",
  "description": "基于自控力理论的Telegram机器人",
  "main": "dist/src/app.js",
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "start": "node dist/src/app.js",
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage",
    "test:integration": "cross-env NODE_ENV=test vitest run tests/integration",
    "test:e2e": "cross-env NODE_ENV=test vitest run tests/e2e",
    "lint": "eslint src config tests --ext .ts",
    "lint:fix": "eslint src config tests --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts' 'config/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'config/**/*.ts' 'tests/**/*.ts'",
    "setup": "node scripts/setup.js",
    "migrate": "node scripts/migrate.js",
    "migrate:xuanjian-cultivation": "tsx scripts/migrate-xuanjian-cultivation.ts",
    "seed:xuanjian-content": "tsx scripts/seed-xuanjian-content.ts",
    "validate:xuanjian-content": "tsx scripts/validate-xuanjian-content.ts",
    "seed": "node scripts/seed.js",
    "docker:build": "docker build -t telegram-self-control-bot .",
    "docker:dev": "docker-compose up -d",
    "docker:prod": "docker-compose -f docker/docker-compose.prod.yml up -d",
    "docker:stop": "docker-compose down",
    "validate": "yarn typecheck && yarn lint && yarn test",
    "pre-commit": "yarn lint:fix && yarn format && yarn test",
    "pm2:start": "bash scripts/pm2-start.sh",
    "pm2:stop": "pm2 stop telegram-self-control-bot",
    "pm2:restart": "pm2 restart telegram-self-control-bot",
    "pm2:reload": "pm2 reload telegram-self-control-bot",
    "pm2:delete": "pm2 delete telegram-self-control-bot",
    "pm2:logs": "pm2 logs telegram-self-control-bot",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status telegram-self-control-bot",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bull": "^4.11.3",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "joi": "^17.9.2",
    "lodash": "^4.17.21",
    "moment-timezone": "^0.5.43",
    "mongoose": "^7.5.0",
    "node-telegram-bot-api": "^0.61.0",
    "redis": "^4.6.7",
    "tsx": "^4.20.6",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/express": "4",
    "@types/jest": "^29.5.3",
    "@types/lodash": "^4.17.25",
    "@types/node": "22",
    "@types/node-telegram-bot-api": "0.61",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "8",
    "@typescript-eslint/parser": "8",
    "@vitest/coverage-v8": "3.2.7",
    "cross-env": "7",
    "eslint": "^8.45.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.27.5",
    "jest": "^29.6.2",
    "mongodb-memory-server": "^8.15.1",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.0",
    "supertest": "^6.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "keywords": [
    "telegram",
    "bot",
    "self-control",
    "productivity",
    "task-management"
  ],
  "author": "Telegram Self Control Bot",
  "license": "MIT",
  "packageManager": "yarn@4.13.0"
}
